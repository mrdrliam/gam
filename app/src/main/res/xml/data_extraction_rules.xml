<?xml version="1.0" encoding="utf-8"?>
<!-- Behaviour data is personal: no cloud backup. A direct phone-to-phone transfer keeps it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="habit_alarm.xml" />
    </device-transfer>
</data-extraction-rules>
